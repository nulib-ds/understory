version = 0.1

[default.deploy.parameters]
# Pick a stack name unique to you — this becomes your personal dev stack.
# e.g. "jsmith-dev-understory". Everyone on the team deploys their own copy
# of this stack rather than sharing one. Shared environments take the same
# shape: "staging-understory", "production-understory".
stack_name = "<your-username>-dev-understory"
resolve_s3 = true
region = "us-east-1"
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND"

# GitHub repo URL — https://github.com/nulib-ds/understory, or your fork of it
# GitHub personal access token — needs "repo" scope
#   Generate one at: https://github.com/settings/tokens → Generate new token (classic) → check "repo"
# GitHub branch to deploy (default: main)
#
# Search needs no parameters: every stack provisions its own OpenSearch
# Serverless collection (SearchCollection), which scales to zero when idle.
# Two optional ones:
#   SearchMaxOcu       capacity ceiling, the spend cap (2, 4, 8 or 16; default 2)
#   SearchIndexPrefix  defaults to the stack name; must be lowercase. Index names
#                      are <prefix>.<slug>._pub.<runId>, with <prefix>.<slug> as
#                      the alias a consuming site points at.
#
# Keep stack_name to 27 characters or fewer: the search collection and its
# policies are named after it, and Serverless caps those names.
parameter_overrides = "GitHubRepo=https://github.com/nulib-ds/understory GitHubOAuthToken=ghp_your_token_here GitHubBranch=main"
