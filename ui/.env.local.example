# Copy to .env.local (gitignored) and fill in from your personal stack's outputs:
#   aws cloudformation describe-stacks --stack-name <your-stack-name> --query 'Stacks[0].Outputs'
#
# Mapping from CloudFormation output key -> variable:
#   ImagesEndpoint          -> NEXT_PUBLIC_IIIF_BASE_URL  (the Image API base, despite
#                                                        the name. NOT IiifEndpoint, which
#                                                        is the Lambda Function URL behind
#                                                        the CDN.)
#   ManifestApiUrl          -> NEXT_PUBLIC_MANIFEST_API_URL (append /manifests)
#   ManifestApiUrl          -> NEXT_PUBLIC_COLLECTION_API_URL (append /collections)
#   IIIFBucketName          -> NEXT_PUBLIC_STORAGE_BUCKET
#   SourceBucketName        -> NEXT_PUBLIC_SOURCE_BUCKET
#   CognitoIdentityPoolId   -> NEXT_PUBLIC_STORAGE_IDENTITY_POOL_ID
#   CognitoUserPoolId       -> NEXT_PUBLIC_COGNITO_USER_POOL_ID
#   CognitoClientId         -> NEXT_PUBLIC_COGNITO_CLIENT_ID
#
# Next.js inlines NEXT_PUBLIC_* into the browser bundle when it builds, so a
# change here needs a restart of `npm run dev`.

NEXT_PUBLIC_IIIF_BASE_URL=
NEXT_PUBLIC_MANIFEST_API_URL=
NEXT_PUBLIC_COLLECTION_API_URL=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_SOURCE_BUCKET=
NEXT_PUBLIC_STORAGE_REGION=us-east-1
NEXT_PUBLIC_STORAGE_IDENTITY_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
